<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:D3skCommander.App.Features.MultiRename"
             x:Class="D3skCommander.App.Features.MultiRename.RenameView"
             x:DataType="m:RenameViewModel">
  <Grid Margin="12" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnSpacing="12" RowSpacing="6">
      <TextBlock x:Name="NameLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
      <TextBox x:Name="MaskBox" Grid.Row="0" Grid.Column="1" Text="{Binding NameMask, Mode=TwoWay}"/>
      <WrapPanel x:Name="TokenPanel" Grid.Row="1" Grid.Column="1" Orientation="Horizontal"/>
      <TextBlock x:Name="ExtLabel" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
      <TextBox x:Name="ExtBox" Grid.Row="2" Grid.Column="1" Text="{Binding ExtMask, Mode=TwoWay}"/>
      <TextBlock x:Name="SearchLabel" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
      <TextBox x:Name="SearchBox" Grid.Row="3" Grid.Column="1" Text="{Binding Search, Mode=TwoWay}"/>
      <TextBlock x:Name="ReplaceLabel" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
      <TextBox x:Name="ReplaceBox" Grid.Row="4" Grid.Column="1" Text="{Binding Replace, Mode=TwoWay}"/>
      <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="16">
        <CheckBox x:Name="RegexBox" IsChecked="{Binding UseRegex, Mode=TwoWay}"/>
        <CheckBox x:Name="SensitiveBox" IsChecked="{Binding CaseSensitive, Mode=TwoWay}"/>
      </StackPanel>
      <TextBlock x:Name="CaseLabel" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
      <ComboBox x:Name="CaseBox" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Stretch"
                SelectedIndex="{Binding CaseIndex, Mode=TwoWay}"/>
      <TextBlock x:Name="CounterLabel" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"/>
      <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="StartLabel" VerticalAlignment="Center"/>
        <NumericUpDown x:Name="StartBox" Width="120" FormatString="0" Value="{Binding CounterStart, Mode=TwoWay}"/>
        <TextBlock x:Name="StepLabel" VerticalAlignment="Center"/>
        <NumericUpDown x:Name="StepBox" Width="120" FormatString="0" Value="{Binding CounterStep, Mode=TwoWay}"/>
        <TextBlock x:Name="DigitsLabel" VerticalAlignment="Center"/>
        <NumericUpDown x:Name="DigitsBox" Width="100" FormatString="0" Minimum="1" Maximum="12"
                       Value="{Binding CounterDigits, Mode=TwoWay}"/>
      </StackPanel>
    </Grid>
    <ContentControl x:Name="PreviewHost" Grid.Row="1" MinHeight="120"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
      <Button x:Name="RunButton" MinWidth="88" Command="{Binding StartCommand}"/>
      <Button x:Name="UndoButton" MinWidth="88" Command="{Binding UndoCommand}"/>
    </StackPanel>
    <TextBlock x:Name="StatusLine" Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap"/>
  </Grid>
</UserControl>
