<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:q="using:D3skCommander.App.Features.QuickFind"
             x:Class="D3skCommander.App.Features.QuickFind.QuickFindView"
             x:DataType="q:QuickFindViewModel">
  <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">
    <TextBox x:Name="QueryBox" Grid.Row="0" Text="{Binding QueryText, Mode=TwoWay}"/>
    <Grid x:Name="HeaderRow" Grid.Row="1" ColumnDefinitions="18,3*,4*,84,130" Margin="8,0,24,0" Opacity="0.7">
      <TextBlock x:Name="NameHeader" Grid.Column="1"/>
      <TextBlock x:Name="FolderHeader" Grid.Column="2"/>
      <TextBlock x:Name="SizeHeader" Grid.Column="3" HorizontalAlignment="Right"/>
      <TextBlock x:Name="DateHeader" Grid.Column="4" Margin="12,0,0,0"/>
    </Grid>
    <ListBox x:Name="ResultList" Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="q:QuickFindRow">
          <Grid ColumnDefinitions="18,3*,4*,84,130">
            <TextBlock Grid.Column="0" Text="{Binding Marker}" Opacity="0.7"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2" Text="{Binding Folder}" TextTrimming="PathSegmentEllipsis" Opacity="0.8"/>
            <TextBlock Grid.Column="3" Text="{Binding SizeText}" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="4" Text="{Binding DateText}" Margin="12,0,0,0" Opacity="0.8"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <ProgressBar Grid.Column="0" IsIndeterminate="{Binding IsBuilding}" IsVisible="{Binding IsBuilding}" Width="90" MinWidth="90" VerticalAlignment="Center"/>
      <TextBlock x:Name="StatusText" Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button x:Name="CancelButton" IsVisible="{Binding IsBuilding}"/>
        <Button x:Name="RebuildButton" IsEnabled="{Binding !IsBuilding}"/>
        <Button x:Name="FeedButton"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
