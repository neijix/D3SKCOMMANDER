<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="using:D3skCommander.App.Features.DiskUsage"
             x:Class="D3skCommander.App.Features.DiskUsage.DiskUsageView"
             x:DataType="d:DiskUsageViewModel">
  <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
      <Button x:Name="UpButton" Grid.Column="0" IsEnabled="{Binding CanGoUp}"/>
      <TextBlock x:Name="PathText" Grid.Column="1" Text="{Binding PathText}" VerticalAlignment="Center"
                 FontWeight="SemiBold" TextTrimming="PathSegmentEllipsis"/>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock x:Name="TotalsText" Grid.Column="0" Text="{Binding TotalsText}" VerticalAlignment="Center"
                 TextWrapping="Wrap" Opacity="0.85"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasStatus}">
        <ProgressBar IsIndeterminate="{Binding IsScanning}" IsVisible="{Binding IsScanning}" Width="90" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusText" Text="{Binding Status}" VerticalAlignment="Center"/>
        <Button x:Name="CancelButton" IsVisible="{Binding IsScanning}"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="*,5,*" ColumnSpacing="0">
      <Grid Grid.Column="0" RowDefinitions="Auto,*" MinWidth="360">
        <Grid x:Name="HeaderRow" Grid.Row="0" ColumnDefinitions="18,*,84,56,118" Margin="8,0,8,4" Opacity="0.7">
          <TextBlock x:Name="NameHeader" Grid.Column="1"/>
          <TextBlock x:Name="SizeHeader" Grid.Column="2" HorizontalAlignment="Right"/>
          <TextBlock x:Name="ShareHeader" Grid.Column="3" HorizontalAlignment="Right"/>
          <TextBlock x:Name="BarHeader" Grid.Column="4" Margin="12,0,0,0"/>
        </Grid>
        <ListBox x:Name="RowList" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="d:DiskUsageRow">
              <Grid ColumnDefinitions="18,*,84,56,118">
                <TextBlock Grid.Column="0" Text="{Binding Marker}" Opacity="0.7"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="{Binding PercentText}" HorizontalAlignment="Right" Opacity="0.8"/>
                <Border Grid.Column="4" Margin="12,0,0,0" Height="10" VerticalAlignment="Center" CornerRadius="2"
                        Background="#22808080" HorizontalAlignment="Stretch">
                  <Border Height="10" CornerRadius="2" HorizontalAlignment="Left" Width="{Binding BarWidth}"
                          Background="{Binding Heat}"/>
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"/>
      <d:RingChart x:Name="Chart" Grid.Column="2" MinWidth="260" Margin="4"
                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                   Separator="{DynamicResource SystemRegionBrush}"/>
    </Grid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
      <Button x:Name="ShowButton"/>
      <Button x:Name="RescanButton"/>
    </StackPanel>
  </Grid>
</UserControl>
