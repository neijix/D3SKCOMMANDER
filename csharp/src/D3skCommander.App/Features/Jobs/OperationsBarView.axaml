<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jobs="using:D3skCommander.App.Features.Jobs"
             x:Class="D3skCommander.App.Features.Jobs.OperationsBarView"
             x:DataType="jobs:OperationsBarModel"
             IsVisible="{Binding IsVisible}">
  <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,2">
    <TextBlock x:Name="TitleText" VerticalAlignment="Center" Text="{Binding Title}"/>
    <TextBlock x:Name="CurrentText" VerticalAlignment="Center" Text="{Binding Current}"/>
    <TextBlock x:Name="ItemsText" VerticalAlignment="Center" Text="{Binding Items}"/>
    <TextBlock x:Name="BytesText" VerticalAlignment="Center" Text="{Binding Bytes}"/>
    <Button x:Name="CancelButton" Content="{Binding CancelText}" Click="OnCancel"/>
  </StackPanel>
</UserControl>
