<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:D3skCommander.App.Features.Crypt"
             x:Class="D3skCommander.App.Features.Crypt.PasswordsView"
             x:DataType="c:PasswordsViewModel">
  <Grid Margin="12" ColumnDefinitions="*,12,*" RowDefinitions="*,Auto" RowSpacing="8">
    <Grid Grid.Column="0" RowDefinitions="*,Auto">
      <ListBox x:Name="KeyList" ItemsSource="{Binding Keys}" SelectedItem="{Binding Selected, Mode=TwoWay}"/>
      <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" Margin="8" TextWrapping="Wrap"/>
    </Grid>
    <StackPanel Grid.Column="2" Spacing="6">
      <TextBlock Text="{Binding NameLabel}"/>
      <TextBox x:Name="NameBox" Text="{Binding EntryName, Mode=TwoWay}"/>
      <TextBlock Text="{Binding SecretLabel}"/>
      <TextBox x:Name="SecretBox" Text="{Binding Secret, Mode=TwoWay}" PasswordChar="{Binding SecretChar}"/>
      <WrapPanel Orientation="Horizontal">
        <Button x:Name="RevealButton" Margin="0,0,6,6" Content="{Binding RevealText}" Command="{Binding RevealCommand}"/>
        <Button x:Name="CopyButton" Margin="0,0,6,6" Content="{Binding CopyText}" Command="{Binding CopyCommand}" IsEnabled="{Binding CanUseEntry}"/>
        <Button x:Name="NewButton" Margin="0,0,6,6" Content="{Binding NewText}" Command="{Binding NewEntryCommand}"/>
        <Button x:Name="SaveButton" Margin="0,0,6,6" Content="{Binding SaveText}" Command="{Binding SaveEntryCommand}" IsEnabled="{Binding CanSave}"/>
        <Button x:Name="RemoveButton" Margin="0,0,6,6" Content="{Binding RemoveText}" Command="{Binding RemoveEntryCommand}" IsEnabled="{Binding CanUseEntry}"/>
        <Button x:Name="LockButton" Margin="0,0,6,6" Content="{Binding LockText}" Command="{Binding LockVaultCommand}" IsEnabled="{Binding IsUnlocked}"/>
      </WrapPanel>
    </StackPanel>
    <TextBlock x:Name="StatusText" Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Status}" TextWrapping="Wrap"/>
  </Grid>
</UserControl>
