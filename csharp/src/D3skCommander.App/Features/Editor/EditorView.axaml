<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:e="using:D3skCommander.App.Features.Editor"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="D3skCommander.App.Features.Editor.EditorView"
             x:DataType="e:EditorViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
  </UserControl.Styles>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8,6">
      <Button x:Name="SaveButton" Content="{Binding SaveLabel}" IsEnabled="{Binding CanEdit}"/>
      <TextBox x:Name="FindBox" MinWidth="160" Text="{Binding FindText, Mode=TwoWay}" PlaceholderText="{Binding FindLabel}"/>
      <Button x:Name="NextButton" Content="{Binding NextLabel}" IsEnabled="{Binding CanEdit}"/>
      <TextBox x:Name="ReplaceBox" MinWidth="160" Text="{Binding ReplaceText, Mode=TwoWay}" PlaceholderText="{Binding ReplaceLabel}"/>
      <Button x:Name="ReplaceButton" Content="{Binding ReplaceOneLabel}" IsEnabled="{Binding CanEdit}"/>
      <Button x:Name="ReplaceAllButton" Content="{Binding ReplaceAllLabel}" IsEnabled="{Binding CanEdit}"/>
      <CheckBox x:Name="CaseBox" IsChecked="{Binding MatchCase, Mode=TwoWay}" Content="{Binding MatchCaseLabel}"/>
    </StackPanel>
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="16" Margin="8,4">
      <TextBlock x:Name="FileLine" Text="{Binding FileName}" FontWeight="Bold"/>
      <TextBlock x:Name="InfoLine" Text="{Binding InfoText}"/>
      <TextBlock x:Name="NoticeLine" Text="{Binding Notice}"/>
    </StackPanel>
    <TextBlock x:Name="ErrorLine" DockPanel.Dock="Top" Margin="8,4" TextWrapping="Wrap" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"/>
    <TextBlock x:Name="LossyLine" DockPanel.Dock="Top" Margin="8,4" TextWrapping="Wrap" Text="{Binding LossyText}" IsVisible="{Binding LossyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    <ae:TextEditor x:Name="Surface" Document="{Binding Buffer}" IsReadOnly="{Binding !CanEdit}" ShowLineNumbers="True"
                   FontFamily="{DynamicResource MonoFont}" HorizontalScrollBarVisibility="Auto"/>
  </DockPanel>
</UserControl>
