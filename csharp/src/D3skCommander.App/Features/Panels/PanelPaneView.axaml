<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:D3skCommander.App.Features.Panels"
             xmlns:controls="using:D3skCommander.App.Controls"
             x:Class="D3skCommander.App.Features.Panels.PanelPaneView"
             x:DataType="panels:PanelPaneModel"
             Focusable="True">
  <UserControl.Styles>
    <Style Selector="Button.bar">
      <Setter Property="Padding" Value="6"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style Selector="TextBlock.active">
      <Setter Property="Foreground" Value="#A6D1FF"/>
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2">
      <DockPanel>
        <controls:PriorityStrip x:Name="Bar" DockPanel.Dock="Left" Spacing="2" Reserve="100" Margin="0,0,4,0"/>
        <TextBox x:Name="PathBox" Text="{Binding Path, Mode=TwoWay}"/>
      </DockPanel>
      <Button x:Name="BrowseButton" Grid.Column="1" Margin="4,0,0,0" Content="{Binding BrowseText}"/>
    </Grid>
    <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="2,0,2,2" IsVisible="{Binding FilterOpen}"
             Text="{Binding FilterText, Mode=TwoWay}" PlaceholderText="{Binding FilterWatermark}"/>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="4,2"
               Classes.active="{Binding IsActive}" Text="{Binding StatusText}"/>
    <Grid>
      <ContentControl x:Name="ListHost" IsVisible="{Binding !HasOverlay}"/>
      <ContentControl x:Name="OverlayHost" IsVisible="{Binding HasOverlay}" Content="{Binding Overlay}"/>
    </Grid>
  </DockPanel>
</UserControl>
