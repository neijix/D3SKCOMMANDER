<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:D3skCommander.App.Features.Panels"
             xmlns:controls="using:D3skCommander.App.Controls"
             x:Class="D3skCommander.App.Features.Panels.PanelPaneView"
             x:DataType="panels:PanelPaneModel"
             Focusable="True">
  <UserControl.Styles>
    <Style Selector="Button.bar">
      <Setter Property="Padding" Value="6"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style Selector="Button.drive">
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.drive.held, Button.drive.held:pointerover">
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.drive.held /template/ ContentPresenter#PART_ContentPresenter, Button.drive.held:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2F6FB5"/>
    </Style>
    <Style Selector="TextBlock.active">
      <Setter Property="Foreground" Value="#A6D1FF"/>
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <ScrollViewer x:Name="DriveScroll" DockPanel.Dock="Top" Margin="2,2,2,0" Height="26"
                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                  IsVisible="{Binding ShowDriveBar}">
      <StackPanel x:Name="DriveStrip" Orientation="Horizontal" Spacing="2"/>
    </ScrollViewer>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2">
      <DockPanel>
        <controls:PriorityStrip x:Name="Bar" DockPanel.Dock="Left" Spacing="2" Reserve="100" Margin="0,0,4,0"/>
        <TextBox x:Name="PathBox" Text="{Binding Path, Mode=TwoWay}"/>
      </DockPanel>
      <Button x:Name="BrowseButton" Grid.Column="1" Margin="4,0,0,0" Content="{Binding BrowseText}"/>
    </Grid>
    <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="2,0,2,2" IsVisible="{Binding FilterOpen}"
             Text="{Binding FilterText, Mode=TwoWay}" PlaceholderText="{Binding FilterWatermark}"/>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="4,2"
               Classes.active="{Binding IsActive}" Text="{Binding StatusText}"/>
    <Grid x:Name="Body" ColumnDefinitions="0,Auto,*">
      <ContentControl x:Name="TreeHost" Grid.Column="0" Margin="2,0,0,0" IsVisible="{Binding ShowTree}"/>
      <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Width="5" Background="Transparent" Focusable="False"
                    ResizeDirection="Columns" IsVisible="{Binding ShowTree}"/>
      <Grid x:Name="ListArea" Grid.Column="2">
        <ContentControl x:Name="ListHost" IsVisible="{Binding !HasOverlay}"/>
        <ContentControl x:Name="OverlayHost" IsVisible="{Binding HasOverlay}" Content="{Binding Overlay}"/>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
