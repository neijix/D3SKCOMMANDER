<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:D3skCommander.App.Features.Catalog"
        x:Class="D3skCommander.App.Features.Catalog.CatalogWindow"
        x:DataType="c:CatalogDialog"
        WindowStartupLocation="CenterOwner"
        Width="720"
        Height="520"
        MinWidth="420"
        MinHeight="360"
        ShowInTaskbar="False">
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="4">
    <TextBlock x:Name="RootLabel" Grid.Row="0"/>
    <TextBox x:Name="RootBox" Grid.Row="1" Text="{Binding Root, Mode=TwoWay}"/>
    <TextBlock x:Name="OutputLabel" Grid.Row="2" Margin="0,8,0,0"/>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox x:Name="OutputBox" Grid.Column="0" Text="{Binding OutputPath, Mode=TwoWay}"/>
    </Grid>
    <Grid Grid.Row="4" RowDefinitions="Auto,Auto,*" Margin="0,8,0,0" RowSpacing="4">
      <TextBlock x:Name="FindLabel" Grid.Row="0"/>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox x:Name="QueryBox" Grid.Column="0" Text="{Binding Query, Mode=TwoWay}"/>
        <Button x:Name="SearchButton" Grid.Column="1" MinWidth="88" IsEnabled="{Binding !IsBusy}"/>
      </Grid>
      <ContentControl x:Name="HitsHost" Grid.Row="2"/>
    </Grid>
    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button x:Name="CreateButton" MinWidth="88" IsEnabled="{Binding !IsBusy}"/>
      <Button x:Name="OpenButton" MinWidth="88"/>
      <Button x:Name="CloseButton" MinWidth="88"/>
    </StackPanel>
    <StackPanel Grid.Row="6" Margin="0,8,0,0">
      <TextBlock x:Name="StatusLine" Text="{Binding Status}" TextWrapping="Wrap"/>
      <TextBlock x:Name="OpenedLine" Text="{Binding OpenedPath}" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</Window>
