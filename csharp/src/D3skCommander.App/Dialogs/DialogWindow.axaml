<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="using:D3skCommander.App.Dialogs"
        x:Class="D3skCommander.App.Dialogs.DialogWindow"
        x:DataType="d:DialogWindowModel"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner"
        Width="440"
        MaxHeight="520"
        CanResize="False"
        ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="ItemsControl">
      <Setter Property="Template">
        <ControlTemplate>
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
        </ControlTemplate>
      </Setter>
    </Style>
  </Window.Styles>
  <Grid Margin="16" RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding ShowMessage}"/>
        <TextBox Text="{Binding Input, Mode=TwoWay}" IsVisible="{Binding ShowInput}"/>
        <ItemsControl ItemsSource="{Binding Choices}" IsVisible="{Binding ShowChoices}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="d:DialogChoiceButton">
              <Button MinWidth="88" Margin="0,0,8,8" Content="{Binding Label}" Command="{Binding PickCommand}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ContentControl Content="{Binding Form}" IsVisible="{Binding ShowForm}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="d:DialogForm">
              <d:FormDialogView/>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="AcceptButton" MinWidth="88" Content="{Binding OkText}" Command="{Binding AcceptCommand}" IsVisible="{Binding ShowAccept}"/>
      <Button x:Name="CancelButton" MinWidth="88" Margin="8,0,0,0" Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsVisible="{Binding ShowCancel}"/>
    </StackPanel>
  </Grid>
</Window>
