<Project>
  <!-- Every NuGet version of the solution, pinned in one place (Central Package Management).
       Choices and rejected options: .github/KNOWLEDGE.md is private, so the why is summarized
       here per group. Licenses: all MIT / Apache-2.0 / BSD unless noted. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a transitive dependency be lifted past a vulnerable version (see Newtonsoft.Json). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- UI -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <!-- Core: formats, protocols, crypto -->
  <ItemGroup>
    <!-- 7z read and write (LZMA/LZMA2), zip, tar, gz, bz2, xz. RAR and the rest stay on external 7z/unrar. -->
    <PackageVersion Include="SharpCompress" Version="0.50.8" />
    <!-- CRC32 for checksums and the splitter's .crc file. -->
    <PackageVersion Include="System.IO.Hashing" Version="10.0.14" />
    <!-- File encryption + password store: libsodium secretstream (XChaCha20-Poly1305) and Argon2id. MIT, libsodium ISC. -->
    <PackageVersion Include="Geralt" Version="4.5.0" />
    <PackageVersion Include="FluentFTP" Version="55.1.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <!-- TIFF only; every other image format is decoded by Avalonia's Skia. -->
    <PackageVersion Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- xunit.v3 3.x: Avalonia.Headless.XUnit 12.1.5 is built on xunit.v3.extensibility.core 3.2.2. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.5" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <!-- In-process FTP/FTPS test server. -->
    <PackageVersion Include="FubarDev.FtpServer" Version="3.1.2" />
    <PackageVersion Include="FubarDev.FtpServer.FileSystem.DotNet" Version="3.1.2" />
    <!-- Transitive pin: FubarDev.FtpServer pulls Newtonsoft.Json 9.0.1 (GHSA-5crp-9r3c-p9vr). -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>
