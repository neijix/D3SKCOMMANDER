<Project>
  <!-- Single place for the version and repository URL; exposed as assembly metadata
       (AssemblyInformationalVersion, RepositoryUrl via AssemblyMetadata). -->
  <PropertyGroup>
    <Version>0.3.5</Version>
    <RepositoryUrl>https://github.com/neijix/D3SKCOMMANDER</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Keep the commit hash out of the informational version so it reads 0.2.1. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RepoRoot>$([MSBuild]::EnsureTrailingSlash('$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..'))'))</RepoRoot>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
  </ItemGroup>
</Project>
