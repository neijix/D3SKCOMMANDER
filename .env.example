# d3skcommander Environment Variables
# Copy this file to .env; every line is optional.
# DO NOT COMMIT .env TO VERSION CONTROL!

# .NET 10 SDK used by csharp/check.sh when `dotnet` is not already on PATH.
# DOTNET_ROOT=/opt/dotnet
# Keep the CLI home and the NuGet cache out of the user profile (optional).
# DOTNET_CLI_HOME=/opt/dotnet/cli-home
# NUGET_PACKAGES=/opt/dotnet/nuget
# PATH prefix, if the SDK folder is not on PATH:
# PATH=/opt/dotnet:$PATH

# release.sh (d3sk-release): signing key file (default ~/.d3skcommander-release/release-signing-key.pem).
# D3SKCOMMANDER_RELEASE_KEY_FILE=/path/to/release-signing-key.pem
# NSIS 3 folder, when makensis is not on PATH (Windows setup).
# NSISDIR=/c/prog/nsis
# rcodesign binary for the macOS signature, when not on PATH.
# RCODESIGN=/opt/rcodesign/rcodesign
# Folder holding the libdmg-hfsplus build (the .dmg); default .tools/libdmg-hfsplus in the repo.
# D3SKCOMMANDER_DMG_TOOLS_DIR=/opt/libdmg-hfsplus
